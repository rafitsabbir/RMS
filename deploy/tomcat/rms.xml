<?xml version="1.0" encoding="UTF-8"?>
<!--
	Tomcat context for RMS: the JNDI DataSource jdbc/springrms that WebConfig.getDataSource looks up.
	Copy it to conf/Catalina/localhost/rms.xml (context path /rms). Never put it in the WAR.

	No values belong in this file. Tomcat fills in each ${...} from an environment variable when it
	starts with this system property (for example in bin/setenv.sh):
		-Dorg.apache.tomcat.util.digester.PROPERTY_SOURCE=org.apache.tomcat.util.digester.EnvironmentPropertySource
	Set these in Tomcat's environment only:
		RMS_DB_URL        jdbc:mysql://<db-host>:<port>/<db-name>?sslMode=REQUIRED&connectTimeout=5000&socketTimeout=60000
		RMS_DB_USER
		RMS_DB_PASSWORD
	connectTimeout and socketTimeout (milliseconds) end a call to a database that doesn't answer, so pages fail
	with an error instead of holding Tomcat's threads; socketTimeout must exceed the slowest query. maxWaitMillis
	(a free pooled connection) and validationQueryTimeout (seconds, the pool's check of a connection) do the same.
	mysql-connector-j-9.7.0.jar goes in Tomcat's lib/. Pool sizes are the DBCP2 defaults (maxTotal 8);
	add maxTotal/maxIdle here if production needs more. See docs/build-run.md.

	E-mail to staff (optional, docs/config.md): RMS_MAIL_HOST, RMS_MAIL_PORT, RMS_MAIL_USER, RMS_MAIL_PASSWORD,
	RMS_MAIL_FROM, RMS_MAIL_SECURITY and RMS_APP_URL in Tomcat's environment too. Without RMS_MAIL_HOST no e-mail is sent.

	HTTPS (owner decision 2026-11-05, docs/release-dev.md): set RMS_SECURE_COOKIE=true in Tomcat's environment
	too, so the session cookie always carries Secure. If a proxy or load balancer ends HTTPS and forwards plain
	HTTP to Tomcat, remove the comment marks around the RemoteIpValve below and set internalProxies to the
	proxy's address (a regular expression): Tomcat then sees the request as HTTPS (HSTS is sent) and
	the browser's address, so the login lock counts per user address, not per proxy.
-->
<Context>
	<Resource name="jdbc/springrms" auth="Container" type="javax.sql.DataSource"
		driverClassName="com.mysql.cj.jdbc.Driver"
		url="${RMS_DB_URL}" username="${RMS_DB_USER}" password="${RMS_DB_PASSWORD}"
		validationQuery="SELECT 1" validationQueryTimeout="5"
		maxWaitMillis="10000"/>
	<!--
	<Valve className="org.apache.catalina.valves.RemoteIpValve"
		internalProxies="10\.0\.0\.5" remoteIpHeader="X-Forwarded-For" protocolHeader="X-Forwarded-Proto"/>
	-->
</Context>
