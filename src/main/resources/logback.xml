<?xml version="1.0" encoding="UTF-8"?>
<!-- Console logging; the servlet container captures stdout (e.g. Tomcat's catalina.out). -->
<configuration>
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<!-- CR/LF in messages are replaced so user input cannot forge log lines -->
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %replace(%msg){'[\r\n]', '_'}%n</pattern>
		</encoder>
	</appender>

	<logger name="rms" level="INFO" />
	<logger name="org.springframework" level="WARN" />

	<root level="INFO">
		<appender-ref ref="CONSOLE" />
	</root>
</configuration>
